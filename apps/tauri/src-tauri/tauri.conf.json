{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeAssist",
  "version": "0.1.0",
  "identifier": "app.typeassist",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TypeAssist",
        "width": 960,
        "height": 800,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "sidecars/typeassist-input-macos"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
