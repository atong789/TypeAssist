{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities granted to the app windows.",
  "windows": ["main", "practice", "progress", "allowlist", "cue", "reconnect"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-hide",
    "core:window:allow-show",
    "positioner:default"
  ]
}
